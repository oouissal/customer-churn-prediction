# ---------------------------------------------------------------------------
# Backend configuration (copy to .env — never commit .env)
# ---------------------------------------------------------------------------
APP_NAME=Customer Churn Prediction API
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (the React dev server + prod UI)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------------
# MLflow (override to point at a shared tracking server)
# ---------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=10
BATCH_PREDICTION_LIMIT=5000
TOP_DRIVERS_COUNT=8
RISK_LOW_BELOW=0.4
RISK_HIGH_ABOVE=0.7

# ---------------------------------------------------------------------------
# Model artefacts (defaults resolve relative to the repository root)
# ---------------------------------------------------------------------------
# CHURN_MODEL_PATH=models/churn_model.joblib
# CHURN_METRICS_PATH=models/metrics.json
# CHURN_TEST_DATA_PATH=data/processed/test.csv
